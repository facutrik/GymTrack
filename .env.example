# Copiá este archivo como ".env" (en la misma carpeta que manage.py) y completá los valores.
# El .env NO se sube a GitHub: tiene contraseñas. Este .env.example sí, como guía.

# --- Django -----------------------------------------------------------------------------
# Clave secreta propia para el servidor. Generala con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
# En el hosting: False. En tu máquina podés dejarlo en True.
DJANGO_DEBUG=True
# Dominios desde los que se accede, separados por coma. Ej: gymtrack.pythonanywhere.com
DJANGO_ALLOWED_HOSTS=

# --- Base de datos ----------------------------------------------------------------------
# Vacío = MySQL (el de tu máquina). "sqlite" = base en un archivo, para hostings sin MySQL
# (en ese caso las variables DB_NAME, DB_USER, etc. no se usan).
DB_ENGINE=
DB_NAME=gymtrack
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# --- Email de GymTrack (Gmail) --------------------------------------------------------------
# Cuenta que usa la app para mandar los mails (recuperar contraseña, Botón de Arrepentimiento).
# La contraseña NO es la de la cuenta: es una "contraseña de aplicación" de 16 letras que se
# genera en https://myaccount.google.com/apppasswords (hay que tener activada la verificación en 2 pasos).
# Si estas dos quedan vacías, los mails se imprimen en la terminal de runserver.
GYMTRACK_EMAIL=
GYMTRACK_EMAIL_PASSWORD=
